# Console do Firebase → Configurações do projeto → Seus apps → app da Web
VITE_FIREBASE_API_KEY=sua-api-key
# o domínio onde o app está publicado (Google/Apple por redirect no iPhone exigem o mesmo domínio)
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.web.app
VITE_FIREBASE_PROJECT_ID=SEU-PROJETO
VITE_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123
# região das Cloud Functions (padrão: southamerica-east1)
VITE_FIREBASE_REGION=southamerica-east1
# gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
# 1 depois de configurar Entrar com Apple (Services ID, chave e provedor Apple no Firebase)
VITE_APPLE_SIGNIN=0
